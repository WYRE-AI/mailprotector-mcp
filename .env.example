# Mailprotector credentials for stdio and for HTTP only when AUTH_MODE=env.
# The gateway Compose service does not load these. Do not add them to that
# service's environment or via env_file. Gateway mode requires the
# X-Mailprotector-Api-Key and X-Mailprotector-Reseller-Id headers on each request.
MAILPROTECTOR_API_KEY=
MAILPROTECTOR_RESELLER_ID=
# Optional API host override. Default https://emailservice.io.
# MAILPROTECTOR_BASE_URL=

# Transport: stdio (default) or http
MCP_TRANSPORT=http
MCP_HTTP_PORT=8080
# Bind address. With a real CONDUIT_S2S_SECRET, an unset MCP_HTTP_HOST stays
# 0.0.0.0 so container deploys keep the historical bind. The image and Compose
# set 0.0.0.0 inside the container and publish the host port on 127.0.0.1.
# MCP_ALLOW_INSECURE_DEV=1 ignores a wider address and binds 127.0.0.1 only; a
# non-loopback value refuses to start.
# MCP_HTTP_HOST=127.0.0.1

# Required to start the HTTP transport. The process logs an error and exits
# non-zero when this is empty or a known placeholder (changeme, secret,
# replace-me, and the other example values). Generate with:
#   openssl rand -hex 32
# Never commit a real secret. The value is never logged.
CONDUIT_S2S_SECRET=

# Local development only. Set to exactly 1 to start HTTP without
# CONDUIT_S2S_SECRET. The server logs a warning, does not check X-Gateway-S2S,
# and binds 127.0.0.1. A non-loopback MCP_HTTP_HOST refuses to start.
# A known placeholder secret still refuses to start when this is set.
# MCP_ALLOW_INSECURE_DEV=1

# Credential source for HTTP: env (process environment) or gateway (required
# X-Mailprotector-Api-Key and X-Mailprotector-Reseller-Id headers; no env
# fallback). The container image and Compose service set gateway. Stdio
# ignores this and reads MAILPROTECTOR_* from the environment.
AUTH_MODE=gateway

# Log level: debug, info, warn, error
LOG_LEVEL=info
